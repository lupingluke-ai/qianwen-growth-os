# Neon Postgres 连接串（Vercel Marketplace 安装 Neon 集成后自动注入；本地填 Neon dev 分支的连接串）
# 本地开发可不设置：会自动回退到内嵌 Postgres（pglite，数据存于 ./.pglite，首次启动自动建表）
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# Auth.js 会话签名密钥（生成：npx auth secret）
AUTH_SECRET=""

# 可选：seed 脚本的演示账号统一初始密码（不设置则随机生成并打印一次）
# SEED_PASSWORD=""
